# Copie os nomes abaixo pras variáveis de ambiente do site na Netlify (Site settings >
# Environment variables) quando for pra produção. Não commitar valores reais.

# LiveKit Cloud (plano gratuito Build, sem cartão) -> cloud.livekit.io > Settings > Keys
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Firebase (plano gratuito Spark, sem cartão) -> Configurações do projeto > Contas de serviço
# > Gerar nova chave privada. Copie os 3 campos do JSON baixado.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
