# Copy the names below into the site's environment variables on Netlify (Site settings >
# Environment variables) when going to production. Do not commit real values.

# LiveKit Cloud (free Build plan, no card) -> cloud.livekit.io > Settings > Keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Firebase (free Spark plan, no card) -> Project settings > Service accounts
# > Generate new private key. Copy the 3 fields from the downloaded JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
