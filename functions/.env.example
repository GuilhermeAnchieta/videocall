# Copy to `.env.<your-firebase-project-id>` (or set via `firebase functions:secrets:set`)
# once you have a real LiveKit Cloud project. Get these from the LiveKit Cloud dashboard.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
